[TEMPLATE]
# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# 1 = Telegram Stars | 0 = тестовый режим ЮKassa
STAR_PAYMENTS=1

# Тестовый токен провайдера для ЮKassa — выдаёт @BotFather (меню Payments)
# Нужен только если STAR_PAYMENTS=0
YOOKASSA_PROVIDER_TOKEN=

# --- Продвинутые настройки ---
# Тарифы заданы в config.py: starter (50⭐/30дн), pro (120⭐/90дн), business (200⭐/180дн)
# Бесплатный пробный период (дней), один раз на пользователя
TRIAL_DAYS=3

# Резервные значения (для обратной совместимости)
PRICE_STARS=50
PRICE_RUB=199
SUBSCRIPTION_DAYS=30

# Минимальный интервал между сообщениями пользователя (секунды)
THROTTLE_MIN_INTERVAL=0.7
