# Токен бота от @BotFather (обязательно)
WB_BOT_TOKEN=123456:ABC-DEF...

# 1 = Telegram Stars | 0 = тестовый режим ЮKassa
STAR_PAYMENTS=1

# Цена подписки
PRICE_STARS=50
PRICE_RUB=199

# Тестовый токен провайдера для ЮKassa — выдаёт @BotFather (меню Payments)
# Нужен только если STAR_PAYMENTS=0
YOOKASSA_PROVIDER_TOKEN=

# Длительность подписки в днях
SUBSCRIPTION_DAYS=30
